{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bay-referee:claims-sources:1",
  "title": "BAY REFEREE claims and factual sources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "claims",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "COMPLETE",
        "REVIEW_NEEDED"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source_ids",
          "verdict",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "verdict": {
            "enum": [
              "SUPPORTED",
              "REVISE",
              "UNVERIFIED"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "reference",
          "accessed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "accessed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETE"
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "minItems": 1,
            "items": {
              "properties": {
                "verdict": {
                  "const": "SUPPORTED"
                }
              }
            }
          },
          "sources": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
