{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:video-engine:higgsfield:generation-decision:1",
  "title": "Single supporting-asset generation decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "experiment_id",
    "decision",
    "need",
    "why_existing_real_asset_and_code_motion_are_insufficient",
    "what_will_be_generated",
    "factual_risk",
    "expected_usage_duration_seconds",
    "expected_benefit",
    "asset_count",
    "historical_evidence_replacement"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "NONE",
        "GENERATE"
      ]
    },
    "need": {
      "type": "string",
      "minLength": 1
    },
    "why_existing_real_asset_and_code_motion_are_insufficient": {
      "type": "string",
      "minLength": 1
    },
    "what_will_be_generated": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "factual_risk": {
      "type": "string",
      "minLength": 1
    },
    "expected_usage_duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "expected_benefit": {
      "type": "string",
      "minLength": 1
    },
    "asset_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "historical_evidence_replacement": {
      "const": false
    },
    "classification": {
      "enum": [
        "generated supporting media"
      ]
    },
    "generation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "params",
        "credit_log_path",
        "reference_assets",
        "authorization_basis"
      ],
      "properties": {
        "tool": {
          "enum": [
            "mcp__codex_apps__higgsfield_generate_image",
            "mcp__codex_apps__higgsfield_generate_video"
          ]
        },
        "params": {
          "type": "object",
          "required": [
            "model",
            "prompt",
            "count"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "count": {
              "const": 1
            }
          },
          "additionalProperties": true
        },
        "credit_log_path": {
          "type": "string",
          "minLength": 1
        },
        "reference_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "rights_evidence_path",
              "sha256"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "rights_evidence_path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "authorization_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "NONE"
          }
        }
      },
      "then": {
        "properties": {
          "what_will_be_generated": {
            "type": "null"
          },
          "expected_usage_duration_seconds": {
            "const": 0
          },
          "asset_count": {
            "const": 0
          }
        },
        "not": {
          "required": [
            "generation_request"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "GENERATE"
          }
        }
      },
      "then": {
        "required": [
          "classification",
          "generation_request"
        ],
        "properties": {
          "what_will_be_generated": {
            "type": "string",
            "minLength": 1
          },
          "expected_usage_duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "asset_count": {
            "const": 1
          }
        }
      }
    }
  ]
}
